        "graph={\n",
        "    'A':['B','C'],\n",
        "    'B':[],\n",
        "    'C':[]\n",
        "}\n",
        "visited=set()\n",
        "def dfs(node):\n",
        "  if node not in visited:\n",
        "    print(node,end=\"\")\n",
        "    visited.add(node)\n",
        "    for neighbour in graph[node]:\n",
        "      dfs(neighbour)\n",
        "print(\"DFS Traversal:\")\n",
        "dfs('A')"
